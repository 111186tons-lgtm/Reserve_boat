APP_NAME=Boat Reserve
ENVIRONMENT=development
DATABASE_URL=sqlite:///./boat_reserve.db

# Telegram: copy this file to .env and fill locally. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_EXPECTED_USERNAME=SPB_boat_bot
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_DROP_PENDING_UPDATES=false
TELEGRAM_SETUP_PROFILE_ON_START=false
TELEGRAM_REQUEST_TIMEOUT_SECONDS=15
TELEGRAM_LONG_POLL_TIMEOUT_SECONDS=25
TELEGRAM_RETRY_DELAY_SECONDS=5
TELEGRAM_PROXY_URL=
TELEGRAM_USE_WINDOWS_PROXY=true
TELEGRAM_USE_SYSTEM_CA=true
TELEGRAM_FORCE_IPV4=true
TELEGRAM_CA_BUNDLE=
TELEGRAM_BOT_DISPLAY_NAME=SPB_boat
TELEGRAM_BOT_DESCRIPTION=Бронирование прогулок на катерах в Санкт-Петербурге: выбор катера, даты и времени, заявка и подтверждение в Telegram.
TELEGRAM_BOT_SHORT_DESCRIPTION=Прогулки на катерах в Санкт-Петербурге
MINI_APP_URL=http://127.0.0.1:8787
MINI_APP_BACKUP_URL=

# Local administrator settings
ADMIN_TELEGRAM_IDS=
DEV_AUTH_ENABLED=true
DISPATCHER_ACCESS_CODE=
DISPATCHER_SESSION_SECRET=replace-with-random-secret
DISPATCHER_SESSION_HOURS=12
HOLD_MINUTES=20
PAYMENT_REVIEW_MINUTES=60

# Google Sheets / Calendar. Keep real IDs and credentials only in .env.
GOOGLE_SHEETS_SYNC_ENABLED=true
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_BOATS_SHEET=Катера
GOOGLE_SHEETS_BERTHS_SHEET=Причалы
GOOGLE_SHEETS_GROUP_RIDES_SHEET=Сборные прогулки
GOOGLE_SHEETS_SETTINGS_SHEET=Настройки
GOOGLE_SHEETS_TIMEOUT_SECONDS=12
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=0
GOOGLE_SHEETS_TEMPLATES_SHEET=Шаблоны
GOOGLE_SHEETS_BOOKINGS_SHEET=Подтвержденные брони
GOOGLE_SHEETS_GROUP_TICKETS_SHEET=Билеты сборных прогулок
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_FILE=google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=google-oauth-token.json
GOOGLE_CALENDAR_ID=

PUBLIC_GUEST_AUTH_ENABLED=true
GUEST_SESSION_SECRET=replace-with-random-secret
TELEGRAM_ADMIN_NOTIFICATIONS_ENABLED=true
TELEGRAM_LINK_SECRET=replace-with-random-secret
